SPORTRADAR_API_KEY=
SPORTRADAR_KEY_ROTATED_AT=
SPORTRADAR_KEY_EXPIRES_AT=

# Kalshi trade API auth.
# Create/download an API key from Kalshi and save the private key PEM locally.
# Do not paste private key contents here; point to the PEM file path instead.
KALSHI_ENV=demo
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_TRADING_ENABLED=false
# Optional explicit override, including /trade-api/v2.
# KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
